            "$ref": "#/components/schemas/WriteCustomFormat"
          },
          {
            "$ref": "#/components/schemas/ValueFormat"
          },
          {
            "$ref": "#/components/schemas/SparkplugFormat"
          }
        ],
        "title": "Format",
        "description": "The format of the messages from the source. This is used to convert messages coming from the source system to a format that can be inserted into CDF.",
        "type": "object"
      },
      "config": {
        "$ref": "#/components/schemas/JobConfig"
      },
      "name": {
        "title": "Name",
        "type": "string",
        "maxLength": 50
      },
      "description": {
        "title": "Description",
        "type": "string",
        "maxLength": 500
      },
      "metadata": {
        "$ref": "#/components/schemas/HostedExtractorMetadata"
      }
    },
    "required": [
      "sourceId",
      "destinationId",
      "externalId",
      "format"
    ],
    "title": "CreateJob",
    "type": "object"
  },
